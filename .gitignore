# Run artefacts: masks, QA plots, CSVs, reports. Regenerable from the script + run_config.json.
# These are derived from third-party photographs and must not be committed: only docs/img/
# carries images, and every one of those has per-image attribution.
# `outputs/` is the --out default in adapt_unet.py; keep the two in step.
outputs/
# out_unet/ was briefly the default and a stray run of it still exists in some working
# copies; ignored so it cannot be picked up again.
out_unet/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Model weights / HF cache ---
*.pt
*.pth
*.safetensors

# --- OS ---
.DS_Store
Thumbs.db

# Notebook run artefacts (same rule as outputs/: derived from third-party photographs)
notebook/runs/
notebook/*.pdf
